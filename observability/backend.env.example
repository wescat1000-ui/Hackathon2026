# Backend process environment only. Never prefix these with VITE_.
OTEL_SERVICE_NAME=rally-backend
OTEL_RESOURCE_ATTRIBUTES=service.namespace=rally,deployment.environment.name=development
# Copy the OTLP HTTP base endpoint from your Dash0 account.
DASH0_OTEL_COLLECTOR_BASE_URL=
# Replace locally with a separate backend ingest token; do not commit real values.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer REPLACE_LOCALLY,Dash0-Dataset=default
# Start with traces only to avoid exporting existing prints of attendee notes.
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
