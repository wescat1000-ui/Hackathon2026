# Copy to .env.local; restart npm run dev after editing.
# Leave disabled until you have your Dash0 account's settings.
VITE_DASH0_ENABLED=false
VITE_DASH0_ENDPOINT=
# Public browser token: dedicated, ingest-only, scoped to the browser dataset.
# VITE_ values are visible in the built JavaScript. Never use a backend/admin token.
VITE_DASH0_AUTH_TOKEN=
VITE_DASH0_DATASET=default
# Optional: exact backend origin, e.g. http://localhost:8000 (no path).
# Set only after the API allows traceparent in its CORS configuration.
VITE_API_ORIGIN=
